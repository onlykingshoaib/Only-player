{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "godot: build",
            "type": "shell",
            "command": "godot",
            "args": [
                "--path",
                "${workspaceFolder}",
                "--build-solutions"
            ],
            "problemMatcher": []
        },
        {
            "label": "godot: run game",
            "type": "shell",
            "command": "godot",
            "args": [
                "--path",
                "${workspaceFolder}"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "godot: export html5",
            "type": "shell",
            "command": "godot",
            "args": [
                "--path",
                "${workspaceFolder}",
                "--export-release",
                "Web",
                "build/index.html"
            ],
            "problemMatcher": []
        }
    ]
}
