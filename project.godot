; Engine configuration for "Only King" Battle Royale
; Godot 4.3 Mobile Optimized

[application]
config/name="Only King"
config/description="Professional Battle Royale for Mobile Tablets (120 FPS)"
config/version="0.1.0"
run/main_scene="res://scenes/Main.tscn"

; Display Configuration for Mobile
[display]
window/size/viewport_width=2560
window/size/viewport_height=1440
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_size"
window/vsync_mode=0
window/per_pixel_transparency/enabled=true

; Rendering Configuration
[rendering]
renderer/rendering_method="forward_plus"
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=false
lights_and_shadows/positional_shadow/atlas_size=2048
global_illumination/sdfgi/enabled=false
anti_aliasing/quality/msaa_3d=2
anti_aliasing/screen_space_denoise/enabled=false
global_illumination/gi/enabled=false

; Performance
[run]
max_fps=120
physics_fps=120

; Input Devices
[input_devices/pointing]
emulate_touch_from_mouse=true

; Physics
[physics]
3d/physics_engine="GodotPhysics3D"
common/physics_fps=120

; Audio
[audio]
buses/default_bus_layout="res://assets/audio/default_bus_layout.tres"

; Mobile Optimization
[rendering/textures]
decals/filter=0
light_projectors/filter=0

[rendering/global_illumination]
probe_visibility/how_often_to_update_dynamic_objects=0

; Input Mapping for Mobile
[input]
ui_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":16777231,"physical_keycode":0,"key_label":0,"unicode":0,"echo":false,"script":null)]
}
ui_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":16777233,"physical_keycode":0,"key_label":0,"unicode":0,"echo":false,"script":null)]
}
ui_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":16777232,"physical_keycode":0,"key_label":0,"unicode":0,"echo":false,"script":null)]
}
ui_down={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":16777234,"physical_keycode":0,"key_label":0,"unicode":false,"script":null)]
}

[debug]
gdscript/warnings/unused_variable=1
gdscript/warnings/unused_parameter=0
gdscript/warnings/unreachable_code=1
gdscript/warnings/shadowed_variable=1
gdscript/warnings/shadowed_variable_base_class=1
